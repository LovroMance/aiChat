{
  "rewrites": [
    { "source": "/auth/(.*)", "destination": "http://47.80.20.35/auth/$1" },
    { "source": "/user/(.*)", "destination": "http://47.80.20.35/user/$1" },
    { "source": "/thread/(.*)", "destination": "http://47.80.20.35/thread/$1" },
    { "source": "/relation/(.*)", "destination": "http://47.80.20.35/relation/$1" },
    { "source": "/file/(.*)", "destination": "http://47.80.20.35/file/$1" },
    { "source": "/debug/(.*)", "destination": "http://47.80.20.35/debug/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
